{
  "name": "anton-barinov/franken-leak-hunter",
  "description": "Production-grade Memory Leak and Cross-Request State Pollution Detector for FrankenPHP, RoadRunner, Swoole, and Laravel Octane. Static AST analyzer + zero-overhead runtime state diffing.",
  "keywords": [
    "frankenphp",
    "memory-leak",
    "state-pollution",
    "profiler",
    "roadrunner",
    "laravel-octane",
    "worker-mode",
    "static-analysis",
    "php-sentinel",
    "swoole"
  ],
  "homepage": "https://github.com/Anton-Barinov/Franken-Leak-Hunter",
  "license": "MIT",
  "authors": [
    {
      "name": "Anton Barinov",
      "homepage": "https://github.com/Anton-Barinov"
    }
  ],
  "type": "library",
  "bin": [
    "bin/franken-leak-hunter"
  ],
  "require": {
    "php": ">=8.1.0"
  },
  "autoload": {
    "psr-4": {
      "FrankenLeakHunter\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run_tests.php",
    "analyze": "bin/franken-leak-hunter analyze src/"
  },
  "config": {
    "sort-packages": true
  }
}
